# KunlunSec AI Platform .env 示例文件
# 请复制此文件为 .env 并填写实际的配置值

# 应用基础配置
APP_NAME=车联网安全测试生命周期管理平台
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# 主机配置
HOST=0.0.0.0
PORT=8000

# 数据库配置
DATABASE_URL=postgresql://admin:admin123@postgres:5432/automotive_security

# Redis配置 
REDIS_URL=redis://redis:6379
# Celery配置依赖Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Chroma向量数据库配置
CHROMA_URL=http://chroma:8000

# JWT配置
# 生产环境中请使用强密钥，可通过以下Python代码生成:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# CORS配置
ALLOWED_ORIGINS=*

# AI模型配置
OPENAI_API_KEY=sk-1234567890
OPENAI_API_BASE=http://172.31.15.200:9997/v1
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=
ANTHROPIC_API_KEY=

# 默认模型配置
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=qwen3

# LLM详细配置
LLM_MODEL=qwen3
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
# LLM_API_KEY 会自动从相应提供商的API密钥中获取
LLM_API_TYPE=openai

# 搜索API配置
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
BING_SEARCH_API_KEY=

# 文件上传配置
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

# WebSocket配置
WEBSOCKET_HEARTBEAT_INTERVAL=30

# 监控配置
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=8001

# 知识库配置
KNOWLEDGE_BASE_COLLECTION_NAME=automotive_knowledge
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# MCP工具配置
MCP_TIMEOUT=30
MCP_MAX_RETRIES=3
MCP_DEFAULT_SERVER_TYPE=stdio
MCP_DEFAULT_COMMAND=python -m mcp.server

# 沙箱配置
SANDBOX_IMAGE=ubuntu:latest
SANDBOX_WORKSPACE=/workspace 