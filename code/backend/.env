# 车联网安全测试生命周期管理平台 - 环境变量配置

# 应用基础配置
APP_NAME="车联网安全测试生命周期管理平台"
APP_VERSION="1.0.0"
DEBUG=true

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置
DATABASE_URL=postgresql://admin:admin123@localhost:5432/automotive_security

# Redis配置
REDIS_URL=redis://localhost:6379

# Chroma向量数据库配置
CHROMA_URL=http://localhost:8000

# JWT配置
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS配置 (使用逗号分隔多个域名)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI模型配置
OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE=http://172.31.15.200/v1

DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 默认模型配置
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=qwen3

# 文件上传配置
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

# WebSocket配置
WEBSOCKET_HEARTBEAT_INTERVAL=30

# Celery配置
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# 监控配置
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=8001

# 知识库配置
KNOWLEDGE_BASE_COLLECTION_NAME=automotive_knowledge
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# MCP工具配置
MCP_TIMEOUT=30
MCP_MAX_RETRIES=3 